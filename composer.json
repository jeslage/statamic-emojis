{
    "name": "jeslage/statamic-emojis",
    "description": "Emoji picker for Statamic: Emoji and Emoji Text fieldtypes, a Bard button, shortcode suggestions, custom emojis and Noto, Fluent or OpenMoji sets",
    "type": "statamic-addon",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "StatamicEmojis\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "StatamicEmojis\\Tests\\": "tests"
        }
    },
    "authors": [
        {
            "name": "Johannes Eslage",
            "email": "hello@johanneseslage.de"
        }
    ],
    "require": {
        "php": "^8.3",
        "statamic/cms": "^6.0",
        "pixelfear/composer-dist-plugin": "^0.1.6"
    },
    "require-dev": {
        "orchestra/testbench": "^10.8"
    },
    "config": {
        "allow-plugins": {
            "pixelfear/composer-dist-plugin": true
        }
    },
    "extra": {
        "statamic": {
            "name": "Emojis",
            "description": "Emoji fieldtypes, a Bard button, shortcode suggestions, custom emojis and emoji sets"
        },
        "laravel": {
            "providers": [
                "StatamicEmojis\\ServiceProvider"
            ]
        },
        "download-dist": {
            "url": "https://github.com/jeslage/statamic-emojis/releases/download/{$version}/dist.tar.gz",
            "path": "resources/dist"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true
}
